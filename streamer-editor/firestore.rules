rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Settings document: the owner reads and writes it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Jobs are created and filled only by the server (Cloud Function and the Actions worker). The owner can read.
      match /jobs/{jobId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
