rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admins are listed in /admins/{uid}. OWNER_EMAIL below is replaced with the owner's email at deploy time (kept out of git).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      // The owners (verified emails) can register themselves as admin on first admin login. Nobody else can.
      allow create: if signedIn() && request.auth.uid == id
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['OWNER_EMAIL', 'OWNER_EMAIL_2']
        && request.resource.data.keys().hasOnly(['email', 'since']);
      allow update, delete: if false;
    }

    // Site settings (banner, pages, texts, MCP list). Everyone can read, only admins can change.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A new user can only create their own profile as an active free user.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'status', 'plan', 'settings', 'lastLogin'])
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'free'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      // Users change only their own settings. Admins change only plan and status.
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'lastLogin']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'plan'])));
      allow delete: if false;

      // Private data. Only the owner can touch it (admins cannot).
      match /private/oauth {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /private/anthropicMeta {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // The user's own Anthropic key: write-only from the app (never read back to a browser). The worker reads it with the admin SDK.
      match /private/anthropic {
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      // Edit jobs. The owner creates a queued job in the app; the owner's own local worker (signed in as the same user) updates its status.
      // Admins can read. Nobody else can touch them.
      match /jobs/{jobId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.status == 'queued'
          && request.resource.data.keys().hasOnly(['status', 'msg', 'file', 'mode', 'aspect', 'res', 'fps', 'format', 'engine', 'createdAt', 'kind'])
          && request.resource.data.file is string && request.resource.data.file.size() < 200;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'msg', 'plan', 'outputs', 'updatedAt']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
