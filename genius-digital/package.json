{
  "name": "genius-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GENIUS DIGITAL — pejabat maya 3D untuk mengurus staf dan AI agent",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/src/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
