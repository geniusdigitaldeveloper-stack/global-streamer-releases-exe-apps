# Salin ke .env. JANGAN commit nilai sebenar.
PORT=8787
HOST=127.0.0.1
# PIN log masuk (tanpa GD_CEO_PIN, log masuk terbuka — demo setempat sahaja)
GD_CEO_PIN=
GD_PA_PIN=
# Kunci induk untuk menyulitkan API key yang disimpan (jika kosong, dijana ke data/master.key)
GD_MASTER_KEY=
# Pilihan: API key melalui environment (alternatif kepada simpanan melalui UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
METRICOOL_API_TOKEN=
